extern print 1 -> void
extern println 1 -> void
extern log 2 -> void

// Tests calling convention for extern functions
func main
-> void
{
	// Parameter(s) for extern functions are pushed on top of the stack
	pushi 10
	calle println
	pushi 200
	calle println
	pushi 10000
	calle println
	
	pushi 10
	calle print
	pushi 123
	calle println
	pushi 1
	pushi 2
	calle log
}
