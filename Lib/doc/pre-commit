#!/bin/bash

# Format all files with clang format
git diff --name-only --staged -z | while IFS= read -r -d '' file
do
 if [ -f "$file" ];
   then
   if [[ "$file" == *.cpp || "$file" == *.cxx  || "$file" == *.h || "$file" == *.hpp || "$file" == *.hxx ]]
       then
           echo "formatting $file"
           clang-format -i --style=file "$file"
           git add -- "$file"
   fi
 fi
done
